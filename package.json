{
  "name": "widget-uso-claude",
  "version": "0.26.1",
  "description": "Headroom: widget de escritorio para Windows que muestra el uso de tu plan de Claude y avisa antes de pasarte del lÃ­mite",
  "author": "Usuario",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "test": "node --test \"pruebas/*.test.js\""
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "cl.widget-uso-claude",
    "productName": "Headroom",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icono.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Headroom-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "OkazoKoroma",
        "repo": "headroom"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
